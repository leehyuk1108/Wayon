<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mini_home_background">

    <ImageView
        android:id="@+id/mini_home_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_mini_home_map"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_mini_home_map_placeholder" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_mini_home_scrim"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_mini_home_bottom_scrim"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/mini_home_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_status_secure"
            android:fontFamily="@font/pretendard_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:text="CHECK STATUS"
            android:textColor="#151619"
            android:textFontWeight="800"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mini_home_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/pretendard_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0"
            android:lineSpacingExtra="-3dp"
            android:maxLines="2"
            android:text="ALL\nGOOD"
            android:textColor="#FFFFFF"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textFontWeight="900"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_home_detail"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/pretendard_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="#E6FFFFFF"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/mini_home_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:fontFamily="@font/pretendard_semibold"
        android:includeFontPadding="false"
        android:text="--"
        android:textColor="#99FFFFFF"
        android:textSize="8sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="7dp"
        android:paddingEnd="15dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mini_home_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="#FFFFFF"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:textFontWeight="850"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="@font/pretendard_semibold"
                android:includeFontPadding="false"
                android:text="km RANGE"
                android:textColor="#A6FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_home_fuel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="end"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="#E6FFFFFF"
                android:textFontWeight="850"
                android:textSize="20sp" />

            <ProgressBar
                android:id="@+id/mini_home_fuel_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#40FFFFFF"
                android:progressTint="#EEF0F3" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
