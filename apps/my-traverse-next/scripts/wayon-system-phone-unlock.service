[Unit]
Description=Wayon authenticated parked system phone unlock
After=bluetooth.service network-online.target
ConditionPathExists=/data/wayon-door/system-unlock.json
ConditionPathExists=/data/wayon-door/system-unlock-enabled

[Service]
User=comma
WorkingDirectory=/data/openpilot
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/data/wayon-door-tools/system-cloud-v1:/data/wayon-door-tools/proximity-v49:/data/wayon-rssi:/data/openpilot/pydeps:/data/openpilot:/data/pythonpath
ExecStart=/usr/local/venv/bin/python3 -u /data/wayon-door-tools/system-cloud-v1/system_phone_auto_unlock.py monitor --execute
NoNewPrivileges=true
UMask=0077
Nice=15
Restart=on-failure
RestartSec=30
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
