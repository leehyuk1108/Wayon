{
  "name": "my-traverse-web",
  "main": "server/worker.mjs",
  "triggers": {"crons": ["23 18 * * *"]},
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "services": [{"binding": "WAYON", "service": "wayon-cloud"}],
  "d1_databases": [{"binding": "DB", "database_name": "my-traverse-web", "database_id": "local-only"}],
  "vars": {"PUBLIC_ORIGIN": "http://localhost:8787"},
  "observability": {"enabled": false}
}
