<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_premium"
    android:orientation="horizontal"
    android:padding="12dp"
    android:baselineAligned="false"
    android:weightSum="10">

    <!-- REBUILD V2: FRESH FILENAME TO BYPASS CACHE -->

    <!-- Left Panel (60%) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="6"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/widget_car_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRAVERSE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Big Range -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <TextView
                android:id="@+id/widget_fuel_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="459"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km"
                android:textColor="#99FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- Fuel Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_lock_idle_low_battery"
                android:tint="#FFFFFF"/>

            <TextView
                android:id="@+id/widget_fuel_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85%"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/widget_last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Updated 12:00"
                android:textColor="#66FFFFFF"
                android:textSize="10sp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Divider Line -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#40FFFFFF"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:src="@android:color/transparent"/>
    </LinearLayout>

    <!-- Right Panel (40% ish, rest of space) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Battery -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/ic_lock_idle_charging"
                    android:tint="#FFFFFF"/>
                <TextView
                    android:id="@+id/widget_bat_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12.2V"
                    android:textColor="#DDFFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"/>
            </LinearLayout>

            <!-- Oil (Wrench) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/ic_menu_manage"
                    android:tint="#FFFFFF"/>
                <TextView
                    android:id="@+id/widget_oil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="72%"
                    android:textColor="#DDFFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Tire (Compass) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/ic_menu_compass"
                    android:tint="#FFFFFF"/>
                <TextView
                    android:id="@+id/widget_tire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#DDFFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"/>
            </LinearLayout>

            <!-- Odo (Map) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="#FFFFFF"/>
                <TextView
                    android:id="@+id/widget_odometer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="42k"
                    android:textColor="#DDFFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Invisible Refresh Button Overlay -->
    <!-- Since FrameLayout overlay failed weights, we append it at end with width 0 but clickable?
         Method: Set click listener on the ROOT view in Code instead of an overlay button.
         Wait, code currently sets to `R.id.widget_btn_refresh`.
         If I remove the button, I must update code.
         SAFE OPTION: Add the button as a 0dp child at the end.
    -->
    <ImageView
        android:id="@+id/widget_btn_refresh"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:src="@android:drawable/ic_popup_sync"
        android:visibility="invisible"/>

    <!-- Hidden Progress Bar (Required by code binding) -->
    <ProgressBar android:id="@+id/widget_fuel_bar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</LinearLayout>
